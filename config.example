#file server configuration
#copy this file to .env and modify as needed

#root directory for serving files (default: ./public)
PUBLIC_DIR=./public

#flask secret key for session security
FLASK_SECRET_KEY=your-secure-secret-key-here

#server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

#api keys for file operations
KEY=your-upload-api-key
DELETE_KEY=your-delete-api-key
HIDDEN_KEY=your-hidden-files-key

#configuration file paths
FOLDER_KEYS_CONFIG=folder_keys.json
FOLDER_VISIBILITY_CONFIG=folder_visibility.json

#semantic search settings (embeddings + cross-encoder reranker)
#all-MiniLM-L6-v2 indexes ~6x faster on a Pi CPU; use BAAI/bge-small-en-v1.5 for
#higher recall if you can afford a much longer index build.
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEARCH_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CACHE_DIR=~/.cache/filebrowser_cache
#cap chunks indexed per file (evenly sampled); keeps builds fast on big PDFs
MAX_CHUNKS_PER_FILE=30

#analytics (activity logging + dashboard); set false to disable
ANALYTICS_ENABLED=true

#shortcuts config
SHORTCUTS_CONFIG=shortcuts.json

